{
  "name": "@drobson03/zendesk-mcp",
  "version": "2.0.2",
  "description": "An MCP server for Zendesk",
  "main": "main.js",
  "keywords": [],
  "author": "Darcy Robson <17976794+drobson03@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/drobson03/zendesk-mcp"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "bin": {
    "zendesk-mcp": "main.js"
  },
  "scripts": {
    "build": "tsdown && cp package.json LICENSE README.md dist/",
    "start": "tsx --env-file=.env src/main.ts",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "generate": "bash scripts/generate-openapi.sh",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@effect/language-service": "^0.27.2",
    "@effect/openapi-generator": "4.0.0-rc.117",
    "@types/node": "^24.0.15",
    "tsdown": "^0.12.9",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "ultracite": "5.0.46",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "effect": "4.0.0-rc.117"
  },
  "engines": {
    "node": ">=22"
  }
}
